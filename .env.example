ACCLY_AUTH_URL=https://auth.accly.net
ACCLY_CORE_URL=https://core.accly.net
ACCLY_LAUNCHER_CLIENT_ID=accly-launcher
VITE_ACCLY_GATEWAY_URL=https://api.accly.net
