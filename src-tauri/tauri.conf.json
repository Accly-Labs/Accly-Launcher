{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accly Launcher",
  "version": "0.1.0",
  "identifier": "net.accly.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Accly Launcher",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://api.github.com https://auth.accly.net https://core.accly.net https://api.accly.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
